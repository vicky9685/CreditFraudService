# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=CreditFraudService
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Ollama / Qwen3 LLM ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:latest
OLLAMA_TIMEOUT=120

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ── ChromaDB Vector Store ─────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_FRAUD_KB=fraud_knowledge_base
CHROMA_COLLECTION_TRANSACTIONS=fraud_transactions

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# ── ADK Agent ─────────────────────────────────────────────────────────────────
ADK_MODEL=ollama/qwen3:latest
ADK_MAX_ITERATIONS=10
ADK_SESSION_TIMEOUT=300

# ── MCP Server ────────────────────────────────────────────────────────────────
MCP_SERVER_NAME=fraud-detection-mcp
MCP_TRANSPORT=stdio

# ── Governance ────────────────────────────────────────────────────────────────
AUDIT_LOG_FILE=./logs/audit.jsonl
GOVERNANCE_POLICY_FILE=./config/policies.yaml
MAX_REQUESTS_PER_MINUTE=60
PII_MASKING_ENABLED=true
REQUIRE_EXPLAINABILITY=true

# ── Risk Thresholds ───────────────────────────────────────────────────────────
RISK_THRESHOLD_HIGH=0.80
RISK_THRESHOLD_MEDIUM=0.50
RISK_THRESHOLD_LOW=0.20
AUTO_BLOCK_THRESHOLD=0.95
